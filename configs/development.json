{
  "finetuning": "full",
  "use_lora": false,
  "base_model": "/opt/models/Qwen3-VL-2B-Instruct",
  "data_root": "/opt/atomvla/data",
  "index_root": "/opt/atomvla/data/training_index_v1",
  "tensorboard_root": "runs/tensorboard",
  "seed": 20261031,
  "world_size": 1,
  "microbatch": 1,
  "accumulation": 32,
  "loader_workers": 2,
  "loader_timeout_seconds": 180,
  "cpu_threads_per_rank": 2,
  "distributed_timeout_seconds": 900,
  "wall_seconds": 172800,
  "idle_seconds": 1800,
  "weight_decay": 0.01,
  "clip_norm": 1.0,
  "stage1_query_dropout": 0.2,
