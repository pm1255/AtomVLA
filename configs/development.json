        "pose": 0.25,
        "pixel": 1.0
      },
      "eval_every": 250,
      "save_every": 500,
      "coverage_every": 100,
      "validation_samples": 128
    },
    "2": {
      "steps": 2000,
      "warmup": 100,
      "vlm_lr": 5e-06,
      "new_lr": 0.0001,
      "weights": {
        "pose": 0.1,
        "pixel": 0.1
      },
      "eval_every": 250,
      "save_every": 500,
      "coverage_every": 100,
      "validation_samples": 128
    }
  },
  "keep_checkpoints": 3,
  "stage2_pixel_loss_dropout": 0.5
}
